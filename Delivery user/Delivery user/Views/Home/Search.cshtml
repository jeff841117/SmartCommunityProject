@model Delivery_user.Models.SearchViewModel
@{
    ViewData["Title"] = "Search";
}

<html>
<head>
    <meta http-equiv="Content-Type" content="text/html; charset=UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta http-equiv="X-UA-Compatible" content="IE=edge" />
    <meta name="author" content="colorlib.com">
    <link href="https://fonts.googleapis.com/css?family=Poppins:300,400,500" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/main.css">
</head>
<body>
    <div class="s002">
        <div class="search-wrapper">
            <fieldset>
                <legend>快遞領取查詢</legend>            
                <form method="get">
                    <div class="inner-form">
                        <!-- 第一個輸入框 -->
                        <div class="input-field first-wrap">
                            <input id="searchInput" type="text" name="searchKeyword" placeholder="請輸入包裹編號" autocomplete="off"
                                   autocorrect="off"
                                   autocapitalize="off"
                                  spellcheck="false" value="@Model.SearchKeyword" required />
                            <button type="button" class="clear-btn" id="clear">&times;</button>
                        </div>

                        <!-- 搜尋按鈕 -->
                        <div class="input-field fourth-wrap">
                            <button class="btn-search" type="submit">查詢</button>
                        </div>
                    </div>
                </form>
            </fieldset>

            <div class="result-container">
                <h2 class="result-title">查詢結果</h2>

                @if (Model != null && Model.Packages != null && Model.Packages.Any())
                {
                    <table class="result-table">
                        <thead>
                            <tr>
                                <th>編號</th>
                                <th>包裹編號</th>
                                <th>姓名</th>
                                <th>電話</th>
                                <th>狀態</th>
                                <th>日期</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (Delivery_user.Models.Package user in Model.Packages)
                            {
                                <tr>
                                    <td>@user.ID</td>
                                    <td>@user.PID</td>
                                    <td>@user.Name</td>
                                    <td>@user.PhoneNumber</td>
                                    <td>@user.STA_Text</td>
                                    <td>@user.Date</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                }
                else
                {
                    <div class="no-data">查無資料</div>
                }
            </div>
        </div>
    </div>
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            // 初始化
            document.querySelectorAll('.input-field').forEach(function (field) {
                const input = field.querySelector('input');
                const clearBtn = field.querySelector('.clear-btn');
                if (!input || !clearBtn) return;
                clearBtn.style.display = input.value.trim().length > 0 ? 'block' : 'none';
            });

            // 監聽輸入事件（動態顯示 / 隱藏 ×）
            document.addEventListener('input', function (e) {
                if (!e.target.matches('.input-field input')) return;
                const input = e.target;
                const clearBtn = input.closest('.input-field').querySelector('.clear-btn');
                if (!clearBtn) return;
                clearBtn.style.display = input.value.trim().length > 0 ? 'block' : 'none';
            });

            // 點擊 × 清除輸入
            document.addEventListener('click', function (e) {
                if (!e.target.matches('.input-field .clear-btn')) return;
                e.preventDefault(); // 防止表單提交
                const clearBtn = e.target;
                const input = clearBtn.closest('.input-field').querySelector('input');
                if (!input) return;
                input.value = '';
                clearBtn.style.display = 'none';
                input.focus();
            });
        });
    </script>

</body>
</html>

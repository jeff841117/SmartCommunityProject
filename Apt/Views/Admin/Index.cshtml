@{
    ViewData["Title"] = "管理員首頁";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container-fluid">
    <div class="row">
        <div class="col-12">
            <div class="d-flex justify-content-between align-items-center mb-4">
                <h1 class="h3 mb-0 text-gray-800">管理員控制台</h1>
                <div>
                    <span class="badge bg-primary fs-6">已登入：@User.Identity?.Name</span>
                </div>
            </div>
        </div>
    </div>

    <div class="row">
        <!-- 用戶管理卡片 -->
        <div class="col-xl-3 col-md-6 mb-4">
            <div class="card border-left-primary shadow h-100 py-2">
                <div class="card-body">
                    <div class="row no-gutters align-items-center">
                        <div class="col mr-2">
                            <div class="text-xs font-weight-bold text-primary text-uppercase mb-1">
                                用戶總數
                            </div>
                            <div class="h5 mb-0 font-weight-bold text-gray-800">
                                <!-- 這裡可顯示真實數據 -->
                                12
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <!-- 在統計卡片區域添加 -->
        <div class="col-xl-3 col-md-6 mb-4">
            <div class="card border-left-info shadow h-100 py-2">
                <div class="card-body">
                    <div class="row no-gutters align-items-center">
                        <div class="col mr-2">
                            <div class="text-xs font-weight-bold text-info text-uppercase mb-1">最後登入</div>
                            <div class="h5 mb-0 font-weight-bold text-gray-800">
                                @User.FindFirst("LastLoginAt")?.Value ?? "從未"
                            </div>
                            <div class="text-xs text-muted">@DateTime.UtcNow.ToLocalTime().ToString("MM/dd HH:mm")</div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <!-- 管理員卡片 -->
        <div class="col-xl-3 col-md-6 mb-4">
            <div class="card border-left-success shadow h-100 py-2">
                <div class="card-body">
                    <div class="row no-gutters align-items-center">
                        <div class="col mr-2">
                            <div class="text-xs font-weight-bold text-success text-uppercase mb-1">
                                管理員
                            </div>
                            <div class="h5 mb-0 font-weight-bold text-gray-800">2</div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- 住戶卡片 -->
        <div class="col-xl-3 col-md-6 mb-4">
            <div class="card border-left-info shadow h-100 py-2">
                <div class="card-body">
                    <div class="row no-gutters align-items-center">
                        <div class="col mr-2">
                            <div class="text-xs font-weight-bold text-info text-uppercase mb-1">
                                住戶
                            </div>
                            <div class="h5 mb-0 font-weight-bold text-gray-800">10</div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- 待處理卡片 -->
        <div class="col-xl-3 col-md-6 mb-4">
            <div class="card border-left-warning shadow h-100 py-2">
                <div class="card-body">
                    <div class="row no-gutters align-items-center">
                        <div class="col mr-2">
                            <div class="text-xs font-weight-bold text-warning text-uppercase mb-1">
                                待處理
                            </div>
                            <div class="h5 mb-0 font-weight-bold text-gray-800">3</div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="row">
        <div class="col-xl-12 col-lg-7">
            <div class="card shadow mb-4">
                <div class="card-header py-3 d-flex flex-row align-items-center justify-content-between">
                    <h6 class="m-0 font-weight-bold text-primary">最新活動</h6>
                </div>
                <div class="card-body">
                    <div class="table-responsive">
                        <table class="table table-bordered" width="100%" cellspacing="0">
                            <thead>
                                <tr>
                                    <th>用戶</th>
                                    <th>動作</th>
                                    <th>時間</th>
                                    <th>狀態</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr>
                                    <td>testtenant</td>
                                    <td>註冊住戶</td>
                                    <td>5分鐘前</td>
                                    <td><span class="badge bg-success">成功</span></td>
                                </tr>
                                <tr>
                                    <td>testadmin</td>
                                    <td>註冊管理員</td>
                                    <td>10分鐘前</td>
                                    <td><span class="badge bg-success">成功</span></td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- 快速操作按鈕 -->
<div class="position-fixed bottom-0 end-0 p-3" style="z-index: 11">
    <div id="adminToast" class="toast" role="alert" aria-live="assertive" aria-atomic="true">
        <div class="toast-header">
            <i class="fas fa-crown text-warning me-2"></i>
            <strong class="me-auto">管理員模式</strong>
            <button type="button" class="btn-close" data-bs-dismiss="toast"></button>
        </div>
        <div class="toast-body">
            歡迎 @User.Identity?.Name！您已進入管理員控制台。
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
    <script>
        // 自動顯示歡迎 Toast
        document.addEventListener('DOMContentLoaded', function () {
            var toastElList = [].slice.call(document.querySelectorAll('#adminToast'));
            var toastList = toastElList.map(function (toastEl) {
                return new bootstrap.Toast(toastEl);
            });
            toastList.forEach(toast => toast.show());
        });
    </script>
}
@{
    ViewData["Title"] = "住戶中心";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var permissions = ViewBag.UserPermissions as List<string> ?? new List<string>();
}

<div class="container-fluid py-4">
    <!-- 住戶歡迎標題 -->
    <div class="row mb-4">
        <div class="col-12">
            <div class="d-flex justify-content-between align-items-center">
                <div>
                    <h1 class="h3 mb-1 text-primary">
                        <i class="fas fa-home me-2"></i>歡迎回來，@User.Identity?.Name！
                    </h1>
                    <p class="mb-0 text-muted">您的專屬社區服務中心</p>
                </div>
                <div class="dropdown">
                    <button class="btn btn-outline-secondary dropdown-toggle" type="button"
                            data-bs-toggle="dropdown">
                        <i class="fas fa-user-circle me-1"></i>@User.Identity?.Name
                        <span class="badge bg-primary ms-1">住戶</span>
                    </button>
                    <ul class="dropdown-menu dropdown-menu-end">
                        <li>
                            <a class="dropdown-item" asp-controller="Account" asp-action="Profile">
                                <i class="fas fa-user me-2"></i>個人資料
                            </a>
                        </li>
                        <li>
                            <a class="dropdown-item" asp-controller="Account" asp-action="ChangePassword">
                                <i class="fas fa-key me-2"></i>更改密碼
                            </a>
                        </li>
                        <li><hr class="dropdown-divider"></li>
                        <li>
                            <form asp-controller="Account" asp-action="Logout" method="post" class="d-inline">
                                <button type="submit" class="dropdown-item">
                                    <i class="fas fa-sign-out-alt me-2"></i>登出
                                </button>
                            </form>
                        </li>
                    </ul>
                </div>
            </div>
        </div>
    </div>

    <!-- 快速功能卡片 -->
    <div class="row g-4 mb-4">
        @if (permissions.Contains("ExpressPickup.Create"))
        {
            <div class="col-xl-3 col-md-6">
                <div class="card h-100 shadow-sm border-0">
                    <div class="card-body text-center p-4">
                        <div class="avatar bg-primary text-white rounded-circle mb-3 mx-auto">
                            <i class="fas fa-shipping-fast fa-2x"></i>
                        </div>
                        <h5 class="card-title">快遞領取</h5>
                        <p class="card-text text-muted small">提交快遞代收申請</p>
                        <a asp-action="ExpressPickup" class="btn btn-primary btn-sm stretched-link">
                            立即提交
                        </a>
                    </div>
                </div>
            </div>
        }

        @if (permissions.Contains("Fee.ViewOwn"))
        {
            <div class="col-xl-3 col-md-6">
                <div class="card h-100 shadow-sm border-0">
                    <div class="card-body text-center p-4">
                        <div class="avatar bg-success text-white rounded-circle mb-3 mx-auto">
                            <i class="fas fa-receipt fa-2x"></i>
                        </div>
                        <h5 class="card-title">費用繳交</h5>
                        <p class="card-text text-muted small">查看和管理您的費用</p>
                        <a asp-action="MyFees" class="btn btn-success btn-sm stretched-link">
                            查看費用
                        </a>
                    </div>
                </div>
            </div>
        }

        @if (permissions.Contains("Rental.ViewOwn"))
        {
            <div class="col-xl-3 col-md-6">
                <div class="card h-100 shadow-sm border-0">
                    <div class="card-body text-center p-4">
                        <div class="avatar bg-info text-white rounded-circle mb-3 mx-auto">
                            <i class="fas fa-building fa-2x"></i>
                        </div>
                        <h5 class="card-title">租賃管理</h5>
                        <p class="card-text text-muted small">管理您的租賃合約</p>
                        <a asp-action="MyRentals" class="btn btn-info btn-sm stretched-link">
                            租賃記錄
                        </a>
                    </div>
                </div>
            </div>
        }

        <div class="col-xl-3 col-md-6">
            <div class="card h-100 shadow-sm border-0">
                <div class="card-body text-center p-4">
                    <div class="avatar bg-secondary text-white rounded-circle mb-3 mx-auto">
                        <i class="fas fa-cog fa-2x"></i>
                    </div>
                    <h5 class="card-title">個人設定</h5>
                    <p class="card-text text-muted small">更新您的帳戶資訊</p>
                    <a asp-controller="Account" asp-action="Profile"
                       class="btn btn-outline-secondary btn-sm stretched-link">
                        帳戶設定
                    </a>
                </div>
            </div>
        </div>
    </div>

    <!-- 最新通知區域 -->
    <div class="row">
        <div class="col-12">
            <div class="card shadow-sm border-0">
                <div class="card-header bg-white border-0">
                    <h6 class="mb-0"><i class="fas fa-bell me-2 text-warning"></i>最新通知</h6>
                </div>
                <div class="card-body">
                    <div class="list-group list-group-flush">
                        <div class="list-group-item px-0">
                            <div class="row align-items-center">
                                <div class="col-auto">
                                    <div class="avatar bg-info text-white rounded-circle">
                                        <i class="fas fa-shipping-fast"></i>
                                    </div>
                                </div>
                                <div class="col">
                                    <div class="d-flex w-100 justify-content-between">
                                        <h6 class="mb-1">您有一件快遞待領取</h6>
                                        <small>2小時前</small>
                                    </div>
                                    <p class="mb-1 text-muted small">快遞已送達，24小時內請至管理室領取</p>
                                </div>
                            </div>
                        </div>
                        <div class="list-group-item px-0">
                            <div class="row align-items-center">
                                <div class="col-auto">
                                    <div class="avatar bg-warning text-white rounded-circle">
                                        <i class="fas fa-receipt"></i>
                                    </div>
                                </div>
                                <div class="col">
                                    <div class="d-flex w-100 justify-content-between">
                                        <h6 class="mb-1">水電費提醒</h6>
                                        <small>昨日</small>
                                    </div>
                                    <p class="mb-1 text-muted small">本月水電費用 NT$1,250，請於3天內繳清</p>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        // 頁面載入動畫
        document.addEventListener('DOMContentLoaded', function() {
            // 歡迎動畫
            const title = document.querySelector('h1');
            title.style.opacity = '0';
            title.style.transform = 'translateY(20px)';
            title.style.transition = 'all 0.6s ease';

            setTimeout(() => {
                title.style.opacity = '1';
                title.style.transform = 'translateY(0)';
            }, 100);
        });
    </script>
}
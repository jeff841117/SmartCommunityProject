@using Microsoft.AspNetCore.Identity
<!DOCTYPE html>
<html lang="zh-TW">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Apt 社區管理系統</title>

    <!-- Bootstrap CSS -->
    <link href="~/lib/bootstrap/dist/css/bootstrap.min.css" rel="stylesheet" />

    <!-- Font Awesome 圖標 -->
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" rel="stylesheet" />

    <!-- Google Fonts -->
    <link href="https://fonts.googleapis.com/css2?family=Noto+Sans+TC:wght@300;400;500;700&display=swap" rel="stylesheet">

    <!-- 自定義 CSS -->
    <link href="~/css/site.css" rel="stylesheet" asp-append-version="true" />
</head>
<body class="d-flex flex-column min-vh-100" style="font-family: 'Noto Sans TC', sans-serif;">
    <!-- 頂部導航欄 -->
    <header>
        <nav class="navbar navbar-expand-lg navbar-light bg-white shadow-sm fixed-top" id="mainNavbar">
            <div class="container">
                <!-- 品牌 Logo -->
                <a class="navbar-brand fw-bold text-primary d-flex align-items-center" asp-controller="Home" asp-action="Index">
                    <i class="fas fa-building me-2" style="font-size: 1.5rem; color: #007bff;"></i>
                    <span>
                        <strong>Apt</strong><br>
                        <small class="text-muted d-none d-lg-block">社區管理系統</small>
                    </span>
                </a>

                <!-- 漢堡選單按鈕 -->
                <button class="navbar-toggler border-0" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav"
                        aria-controls="navbarNav" aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <!-- 導航內容 -->
                <div class="collapse navbar-collapse" id="navbarNav">
                    <!-- 主要導航 -->
                    <ul class="navbar-nav me-auto">
                        <!-- 首頁 -->
                        <li class="nav-item">
                            <a class="nav-link @(ViewContext.RouteData.Values["Controller"]?.ToString() == "Home" &&
                                                                      ViewContext.RouteData.Values["Action"]?.ToString() != "Index1" ? "active" : "")"
                               asp-controller="Home" asp-action="Index">
                                <i class="fas fa-home me-1"></i> 首頁
                            </a>
                        </li>

                        <!-- 住戶專屬導航 -->
                        @if (SignInManager.IsSignedIn(User) && User.IsInRole("Tenant"))
                        {
                            <li class="nav-item">
                                <a class="nav-link @(ViewContext.RouteData.Values["Action"]?.ToString() == "Index1" ? "active" : "")"
                                   asp-controller="Home" asp-action="Index1">
                                    <i class="fas fa-user me-1"></i> 住戶中心
                                </a>
                            </li>
                        }

                        <!-- 管理員專屬導航 -->
                        @if (SignInManager.IsSignedIn(User) && User.IsInRole("Admin"))
                        {
                            <li class="nav-item dropdown">
                                <a class="nav-link dropdown-toggle @(ViewContext.RouteData.Values["Area"]?.ToString() == "Admin" ? "active" : "")"
                                   href="#" id="adminDropdown" role="button" data-bs-toggle="dropdown">
                                    <i class="fas fa-crown me-1"></i> 管理後台
                                </a>
                                <ul class="dropdown-menu shadow">
                                    <li>
                                        <a class="dropdown-item" asp-area="Admin" asp-controller="Admin" asp-action="Index">
                                            <i class="fas fa-tachometer-alt me-2"></i>儀表板
                                        </a>
                                    </li>
                                    <li>
                                        <a class="dropdown-item" asp-area="Admin" asp-controller="Admin" asp-action="Users">
                                            <i class="fas fa-users me-2"></i>用戶管理
                                        </a>
                                    </li>
                                </ul>
                            </li>
                        }
                    </ul>

                    <!-- 帳戶導航 -->
                    @await Html.PartialAsync("_LoginPartial")
                </div>
            </div>
        </nav>
    </header>

    <!-- 主內容區域（✅ 移除載入遮罩） -->
    <div class="container-fluid mt-5 pt-3 flex-grow-1">
        <main role="main" class="pb-3">
            <!-- 頁面標題 -->
            @if (ViewData["Title"] != null)
            {
                <div class="d-flex justify-content-between align-items-center mb-4">
                    <h1 class="h3 mb-0 fw-bold text-dark">@ViewData["Title"]</h1>
                    <nav aria-label="breadcrumb">
                        <ol class="breadcrumb bg-transparent p-0 mb-0">
                            <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index"><i class="fas fa-home me-1"></i>首頁</a></li>
                            <li class="breadcrumb-item active" aria-current="page">@ViewData["Title"]</li>
                        </ol>
                    </nav>
                </div>
            }
            @RenderBody()
        </main>
    </div>

    <!-- 頁尾 -->
    <footer class="border-top bg-white mt-auto">
        <div class="container py-4">
            <div class="row">
                <div class="col-md-6">
                    <div class="d-flex align-items-center">
                        <i class="fas fa-building text-primary me-2" style="font-size: 1.5rem;"></i>
                        <div>
                            <h5 class="mb-1 fw-bold text-dark">Apt 社區管理系統</h5>
                            <p class="mb-0 text-muted small">提供現代化的社區管理解決方案</p>
                        </div>
                    </div>
                </div>
                <div class="col-md-6 text-md-end text-muted small">
                    <p class="mb-1">&copy; 2025 - Apt</p>
                </div>
            </div>
        </div>
    </footer>

    <!-- JavaScript -->
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    @inject SignInManager<Apt.Models.ApplicationUser> SignInManager
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
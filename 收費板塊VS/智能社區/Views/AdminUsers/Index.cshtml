@model IEnumerable<SmartCommunity.Models.User>
@{
    ViewData["Title"] = "住戶清單";
}

<div class="container my-4">
    <h3 class="mb-3">住戶清單</h3>

    <table class="table table-hover align-middle">
        <thead class="table-light">
            <tr>
                <th>房號</th>
                <th>姓名</th>
                <th>Email</th>
                <th>電話</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var u in Model)
            {
                <tr>
                    <td>@u.RoomNumber</td>
                    <td>@u.UserName</td>
                    <td>@u.Email</td>
                    <td>@u.Phone</td>
                    <td>
                        <a class="btn btn-outline-primary btn-sm" asp-action="Edit" asp-route-id="@u.UserID">編輯</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
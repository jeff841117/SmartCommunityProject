@{
    ViewData["Title"] = "登入 - 智能社區系統";
}

<div class="login-container">
    <div class="login-box">
        <h2>智能社區系統</h2>
        <p class="subtitle">請登入您的帳號</p>

        <form method="post" asp-controller="Account" asp-action="Login">
            <div class="input-group">
                <label>帳號</label>
                <input type="text" name="email" placeholder="輸入電子郵件" required />
            </div>
            <div class="input-group">
                <label>密碼</label>
                <input type="password" name="password" placeholder="輸入密碼" required />
            </div>

            <button type="submit" class="btn-login">登入</button>
            <button type="button" class="btn-register" onclick="window.location.href='/Account/Register'">註冊新帳號</button>
        </form>

        @if (ViewBag.Error != null)
        {
            <p class="error">@ViewBag.Error</p>
        }

        <div class="test-account">
            <p>💡 測試帳號：</p>
            <p><strong>帳號：</strong> admin@smart.com</p>
            <p><strong>密碼：</strong> Admin@123</p>
        </div>
    </div>
</div>

<style>
    /* --- 外層容器 --- */
    .login-container {
        height: 100vh;
        display: flex;
        align-items: center;
        justify-content: center;
        background: linear-gradient(135deg, #7b2ff7, #4facfe);
    }

    /* --- 登入框 --- */
    .login-box {
        background: #fff;
        padding: 40px;
        width: 360px;
        border-radius: 15px;
        box-shadow: 0 8px 25px rgba(0, 0, 0, 0.2);
        text-align: center;
    }

        /* --- 標題 --- */
        .login-box h2 {
            color: #4b0082;
            font-weight: 700;
            margin-bottom: 5px;
        }

    .subtitle {
        color: #666;
        margin-bottom: 25px;
    }

    /* --- 輸入框 --- */
    .input-group {
        text-align: left;
        margin-bottom: 15px;
    }

        .input-group label {
            display: block;
            font-weight: 600;
            margin-bottom: 5px;
            color: #333;
        }

        .input-group input {
            width: 100%;
            padding: 10px;
            border-radius: 8px;
            border: 1px solid #ccc;
            font-size: 15px;
            transition: 0.3s;
        }

            .input-group input:focus {
                border-color: #7b2ff7;
                box-shadow: 0 0 5px rgba(123, 47, 247, 0.5);
                outline: none;
            }

    /* --- 按鈕樣式 --- */
    .btn-login, .btn-register {
        width: 100%;
        padding: 10px;
        border: none;
        border-radius: 8px;
        font-size: 16px;
        cursor: pointer;
        margin-top: 10px;
        transition: all 0.3s ease;
    }

    .btn-login {
        background: linear-gradient(90deg, #6a11cb, #2575fc);
        color: white;
    }

        .btn-login:hover {
            background: linear-gradient(90deg, #2575fc, #6a11cb);
        }

    .btn-register {
        background: none;
        color: #6a11cb;
        border: 2px solid #6a11cb;
    }

        .btn-register:hover {
            background: #6a11cb;
            color: white;
        }

    /* --- 錯誤訊息 --- */
    .error {
        color: red;
        margin-top: 15px;
    }

    /* --- 測試帳號提示 --- */
    .test-account {
        margin-top: 25px;
        background: #f3f4ff;
        padding: 15px;
        border-radius: 10px;
        color: #333;
        font-size: 14px;
    }
</style>
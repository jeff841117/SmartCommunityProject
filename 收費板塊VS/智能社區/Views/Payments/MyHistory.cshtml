@model IEnumerable<SmartCommunity.Models.Payment>
@{
    ViewData["Title"] = "繳費紀錄";
}
<div class="container my-4">
    <div class="row justify-content-center">
        <div class="col-lg-10">
            <div class="card shadow-sm border-0">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center mb-3">
                        <h4 class="m-0">
                            <span class="me-2">房號：</span>
                            <span class="badge bg-primary fs-6">@ViewBag.Room</span>
                        </h4>
                        <a class="btn btn-outline-secondary btn-sm" asp-controller="Bills" asp-action="MyUnpaid">
                            回到未繳帳單
                        </a>
                    </div>

                    @if (!Model.Any())
                    {
                        <div class="text-center py-5">
                            <h5 class="text-muted">目前沒有繳費紀錄</h5>
                        </div>
                    }
                    else
                    {
                        <div class="table-responsive">
                            <table class="table table-striped align-middle">
                                <thead class="table-light">
                                    <tr>
                                        <th>項目</th>
                                        <th>帳單金額</th>
                                        <th>付款金額</th>
                                        <th>方式</th>
                                        <th>日期</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var p in Model)
                                    {
                                        <tr>
                                            <td class="fw-semibold">@p.Bill?.FeeItem?.ItemName</td>
                                            <td>@p.Bill?.Amount.ToString("#,0.##")</td>
                                            <td class="text-success fw-semibold">@p.Amount.ToString("#,0.##")</td>
                                            <td><span class="badge bg-info text-dark">@p.PaymentMethod</span></td>
                                            <td>@p.PaymentDate.ToString("yyyy/MM/dd")</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>
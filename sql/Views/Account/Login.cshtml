@model sql.Models.LoginFormViewModel
@{
    ViewData["Title"] = "登入";
    Layout = "";
}

<!DOCTYPE html>
<html lang="zh-TW">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewData["Title"]</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0-alpha1/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="~/css/Login.css" rel="stylesheet" asp-append-version="true">
</head>
<body>
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-md-6">
                <div class="login-container">
                    <div class="login-header">
                        <h2>設備預約系統</h2>
                        <p class="mb-0">請登入您的帳號</p>
                    </div>
                    <div class="login-body">
                        <form method="post">
                            @if (!string.IsNullOrWhiteSpace(Model.ErrorMessage))
                            {
                                <div class="alert alert-danger" role="alert">
                                    @Model.ErrorMessage
                                </div>
                            }

                            <div class="mb-3">
                                <label asp-for="UserName" class="form-label">帳號</label>
                                <input asp-for="UserName" class="form-control" />
                                <span asp-validation-for="UserName" class="text-danger"></span>
                            </div>

                            <div class="mb-3">
                                <label asp-for="Password" class="form-label">密碼</label>
                                <input asp-for="Password" type="password" class="form-control" />
                                <span asp-validation-for="Password" class="text-danger"></span>
                            </div>

                            <button type="submit" class="btn-login mb-3">登入</button>

                            <div class="d-flex justify-content-between align-items-center">
                                <a href="/Home/addAccount" class="btn btn-register">
                                    註冊新帳號
                                </a>
                                <a href="/Account/ForgotPassword" class="btn btn-forgot">
                                    忘記密碼
                                </a>
                            </div>
                        </form>

                        <div class="mt-4 p-3 bg-light rounded">
                            <small class="text-muted">
                                請使用您的帳號密碼登入<br>
                                或點擊「註冊新帳號」創建帳號
                            </small>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0-alpha1/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>

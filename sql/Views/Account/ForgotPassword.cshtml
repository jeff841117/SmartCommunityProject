@model sql.Models.ForgotPasswordFormViewModel
@{
    ViewData["Title"] = "忘記密碼";
    Layout = "";
}

<!DOCTYPE html>
<html lang="zh-TW">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewData["Title"]</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0-alpha1/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="~/css/Login.css" rel="stylesheet" asp-append-version="true">
</head>
<body>
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-md-6">
                <div class="login-container">
                    <div class="login-header">
                        <h2>找回密碼</h2>
                        <p class="mb-0">先申請驗證碼，再輸入新密碼完成重設</p>
                    </div>
                    <div class="login-body">
                        @if (!string.IsNullOrWhiteSpace(Model.ErrorMessage))
                        {
                            <div class="alert alert-danger" role="alert">
                                @Model.ErrorMessage
                            </div>
                        }

                        @if (!string.IsNullOrWhiteSpace(Model.SuccessMessage))
                        {
                            <div class="alert alert-success" role="alert">
                                @Model.SuccessMessage
                            </div>
                        }

                        @if (!string.IsNullOrWhiteSpace(Model.DebugCode))
                        {
                            <div class="alert alert-warning" role="alert">
                                測試環境驗證碼：<strong>@Model.DebugCode</strong>
                            </div>
                        }

                        <form method="post" class="mb-4">
                            <input type="hidden" name="Step" value="request" />

                            <div class="mb-3">
                                <label asp-for="Email" class="form-label">電子郵件</label>
                                <input asp-for="Email" type="email" class="form-control" placeholder="請輸入註冊電子郵件" />
                                <span asp-validation-for="Email" class="text-danger"></span>
                            </div>

                            <button type="submit" class="btn-login mb-2">申請驗證碼</button>
                        </form>

                        <hr />

                        <form method="post">
                            <input type="hidden" name="Step" value="reset" />
                            <input type="hidden" asp-for="Email" />

                            <div class="mb-3">
                                <label asp-for="VerificationCode" class="form-label">6 碼驗證碼</label>
                                <input asp-for="VerificationCode" class="form-control" placeholder="請輸入收到的 6 碼驗證碼" />
                                <span asp-validation-for="VerificationCode" class="text-danger"></span>
                            </div>

                            <div class="mb-3">
                                <label asp-for="NewPassword" class="form-label">新密碼</label>
                                <input asp-for="NewPassword" type="password" class="form-control" placeholder="請輸入新密碼" />
                                <span asp-validation-for="NewPassword" class="text-danger"></span>
                            </div>

                            <div class="mb-3">
                                <label asp-for="ConfirmPassword" class="form-label">確認新密碼</label>
                                <input asp-for="ConfirmPassword" type="password" class="form-control" placeholder="請再次輸入新密碼" />
                                <span asp-validation-for="ConfirmPassword" class="text-danger"></span>
                            </div>

                            <button type="submit" class="btn-login mb-3">重設密碼</button>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0-alpha1/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>

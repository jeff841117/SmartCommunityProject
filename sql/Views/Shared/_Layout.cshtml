<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Equipment</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/sql.styles.css" asp-append-version="true" />
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-light bg-white border-bottom box-shadow mb-3">
            <div class="container-fluid">
                <a class="navbar-brand" asp-area="" asp-controller="Home" asp-action="Index">預約管理</a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                    <ul class="navbar-nav flex-grow-1">
                        <!-- 管理者功能 -->
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-area="" asp-controller="Equipment" asp-action="Index">設備管理</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-area="" asp-controller="Equipment" asp-action="addEquipment">新增設備</a>
                        </li>
                        <!-- 使用者功能 -->
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-area="" asp-controller="Equipment" asp-action="Reservation">預約設備</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-area="" asp-controller="Equipment" asp-action="MyReservations">我的預約</a>
                        </li>
                    </ul>
                    <ul class="navbar-nav">
                        @try
                        {
                            @if (Context.Session.GetString("UserName") != null)
                            {
                                <li class="nav-item">
                                    <span class="nav-link text-dark">歡迎, @Context.Session.GetString("UserName")</span>
                                </li>
                                <li class="nav-item">
                                    <a class="nav-link text-dark" href="/Account/Logout">登出</a>
                                </li>
                            }
                            else
                            {
                                <li class="nav-item">
                                    <a class="nav-link text-dark" href="/Account/Login">登入</a>
                                </li>
                            }
                        }
                        catch (InvalidOperationException)
                        {
                            <li class="nav-item">
                                <a class="nav-link text-dark" href="/Account/Login">登入</a>
                            </li>
                        }
                    </ul>
                </div>
            </div>
        </nav>
    </header>
    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    @* <footer class="border-top footer text-muted">
        <div class="container">
            &copy; 2025 - sql - <a asp-area="" asp-controller="Home" asp-action="Privacy">Privacy</a>
        </div>
    </footer> *@
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>

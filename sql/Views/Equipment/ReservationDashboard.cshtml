@model sql.Models.ReservationManagementPageViewModel
@{
    ViewData["Title"] = "預約管理總覽";
    Layout = "";
}

<!DOCTYPE html>
<html lang="zh-TW">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewData["Title"]</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0-alpha1/dist/css/bootstrap.min.css" rel="stylesheet">
</head>
<body class="bg-light">
    <div class="container py-4">
        <div class="d-flex justify-content-between align-items-center mb-4">
            <div>
                <h1 class="fw-bold mb-1">預約管理總覽</h1>
                <p class="text-muted mb-0">集中查看未來預約、使用中與排隊中資料，並提供管理者干預入口。</p>
            </div>
            <div class="text-end">
                <a href="/Equipment/Index" class="btn btn-outline-secondary">回到設備管理</a>
                <div class="small text-muted mt-2">伺服器時間：@Model.Dashboard.ServerTaiwanTime</div>
            </div>
        </div>

        <div class="card mb-4">
            <div class="card-header bg-info text-white">
                <h5 class="mb-0">未來預約</h5>
            </div>
            <div class="card-body">
                @if (Model.Dashboard.ScheduledReservations.Any())
                {
                    <div class="table-responsive">
                        <table class="table table-striped align-middle">
                            <thead>
                                <tr>
                                    <th>設備</th>
                                    <th>會員</th>
                                    <th>預約時段</th>
                                    <th>狀態</th>
                                    <th>建立時間</th>
                                    <th>查看設備鏈</th>
                                    <th>管理操作</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var reservation in Model.Dashboard.ScheduledReservations)
                                {
                                    <tr>
                                        <td>@reservation.EquipmentName</td>
                                        <td>@reservation.UserId</td>
                                        <td>@reservation.ReservedStartTime.ToString("yyyy-MM-dd HH:mm") - @reservation.ReservedEndTime.ToString("HH:mm")</td>
                                        <td>
                                            <span class="badge @(reservation.Status == 5 ? "bg-warning text-dark" : "bg-info text-dark")">
                                                @reservation.StatusText
                                            </span>
                                        </td>
                                        <td>@reservation.ReservationTime.ToString("yyyy-MM-dd HH:mm")</td>
                                        <td>
                                            <button class="btn btn-sm btn-outline-primary"
                                                    type="button"
                                                    onclick="loadEquipmentChain(@reservation.EquipmentId)">
                                                查看
                                            </button>
                                        </td>
                                        <td class="d-flex flex-wrap gap-2">
                                            <button class="btn btn-sm btn-outline-secondary"
                                                    type="button"
                                                    onclick="openRescheduleModal(@reservation.Id, '@reservation.ReservedStartTime.ToString("yyyy-MM-dd")', '@reservation.ReservedStartTime.ToString("HH:mm")')">
                                                調整時段
                                            </button>
                                            <button class="btn btn-sm btn-outline-danger"
                                                    type="button"
                                                    onclick="forceCancelScheduledReservation(@reservation.Id)">
                                                取消預約
                                            </button>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
                else
                {
                    <div class="text-muted">目前沒有未來預約資料。</div>
                }
            </div>
        </div>

        <div class="card mb-4">
            <div class="card-header bg-primary text-white">
                <h5 class="mb-0">使用中</h5>
            </div>
            <div class="card-body">
                @if (Model.Dashboard.ActiveReservations.Any())
                {
                    <div class="table-responsive">
                        <table class="table table-striped align-middle">
                            <thead>
                                <tr>
                                    <th>設備</th>
                                    <th>會員</th>
                                    <th>開始時間</th>
                                    <th>剩餘時間</th>
                                    <th>狀態</th>
                                    <th>管理操作</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var reservation in Model.Dashboard.ActiveReservations)
                                {
                                    <tr>
                                        <td>@reservation.EquipmentName</td>
                                        <td>@reservation.UserId</td>
                                        <td>@reservation.StartTime.ToString("yyyy-MM-dd HH:mm")</td>
                                        <td>@reservation.RemainingTime 分鐘</td>
                                        <td><span class="badge bg-primary">@reservation.StatusText</span></td>
                                        <td>
                                            <button class="btn btn-sm btn-outline-danger"
                                                    type="button"
                                                    onclick="forceEndUsage(@reservation.Id)">
                                                強制結束使用
                                            </button>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
                else
                {
                    <div class="text-muted">目前沒有使用中資料。</div>
                }
            </div>
        </div>

        <div class="card">
            <div class="card-header bg-warning text-dark">
                <h5 class="mb-0">排隊中</h5>
            </div>
            <div class="card-body">
                @if (Model.Dashboard.WaitingReservations.Any())
                {
                    <div class="table-responsive">
                        <table class="table table-striped align-middle">
                            <thead>
                                <tr>
                                    <th>設備</th>
                                    <th>會員</th>
                                    <th>順位</th>
                                    <th>排隊時間</th>
                                    <th>排隊類型</th>
                                    <th>查看設備鏈</th>
                                    <th>管理操作</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var queue in Model.Dashboard.WaitingReservations)
                                {
                                    <tr>
                                        <td>@queue.EquipmentName</td>
                                        <td>@queue.UserId</td>
                                        <td>第 @queue.Position 位</td>
                                        <td>@queue.QueueTime.ToString("yyyy-MM-dd HH:mm")</td>
                                        <td>@queue.QueueTypeText</td>
                                        <td>
                                            <button class="btn btn-sm btn-outline-primary"
                                                    type="button"
                                                    onclick="loadEquipmentChain(@queue.EquipmentId)">
                                                查看
                                            </button>
                                        </td>
                                        <td>
                                            <button class="btn btn-sm btn-outline-danger"
                                                    type="button"
                                                    onclick="forceCancelQueue(@queue.Id)">
                                                移除排隊
                                            </button>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
                else
                {
                    <div class="text-muted">目前沒有排隊資料。</div>
                }
            </div>
        </div>
    </div>

    <div class="modal fade" id="equipmentChainModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-xl modal-dialog-scrollable">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title" id="equipmentChainTitle">設備預約／排隊鏈</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body" id="equipmentChainBody">
                    <div class="text-muted">載入中...</div>
                </div>
            </div>
        </div>
    </div>

    <div class="modal fade" id="rescheduleModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">調整未來預約時段</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <input type="hidden" id="rescheduleReservationId" />
                    <div class="mb-3">
                        <label for="rescheduleReservationDate" class="form-label">新的預約日期</label>
                        <input type="date" class="form-control" id="rescheduleReservationDate" />
                    </div>
                    <div class="mb-3">
                        <label for="rescheduleReservationTime" class="form-label">新的開始時段</label>
                        <input type="time" class="form-control" id="rescheduleReservationTime" step="900" />
                        <div class="form-text">以 15 分鐘為一個單位，例如 09:00、09:15、09:30。</div>
                    </div>
                    <div id="reschedulePreviewBox" class="alert alert-secondary small mb-3">
                        請先選擇新的日期與時段，再按「預覽影響」查看這次調整的結果。
                    </div>
                    <div class="small text-muted">
                        後台調整時段時，系統仍會重新檢查保留名額與排隊推算規則。
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">取消</button>
                    <button type="button" class="btn btn-outline-primary" onclick="previewRescheduleImpact()">預覽影響</button>
                    <button type="button" class="btn btn-primary" onclick="submitRescheduleReservation(false)">儲存調整</button>
                </div>
            </div>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0-alpha1/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script>
        const rescheduleModalElement = document.getElementById('rescheduleModal');
        const rescheduleModal = new bootstrap.Modal(rescheduleModalElement);

        function forceEndUsage(reservationId) {
            if (!confirm('確定要由管理者強制結束這筆使用中預約嗎？')) {
                return;
            }

            $.post('/Equipment/ForceEndUsage', { reservationId: reservationId })
                .done(function (response) {
                    if (response.success) {
                        alert(response.message);
                        window.location.reload();
                        return;
                    }

                    alert(response.message || '強制結束失敗');
                })
                .fail(function () {
                    alert('強制結束失敗，請稍後再試');
                });
        }

        function forceCancelScheduledReservation(reservationId) {
            if (!confirm('確定要由管理者取消這筆未來預約嗎？')) {
                return;
            }

            $.post('/Equipment/ForceCancelScheduledReservation', { reservationId: reservationId })
                .done(function (response) {
                    if (response.success) {
                        alert(response.message);
                        window.location.reload();
                        return;
                    }

                    alert(response.message || '取消未來預約失敗');
                })
                .fail(function () {
                    alert('取消未來預約失敗，請稍後再試');
                });
        }

        function forceCancelQueue(queueId) {
            if (!confirm('確定要由管理者移除這筆排隊資料嗎？')) {
                return;
            }

            $.post('/Equipment/ForceCancelQueue', { queueId: queueId })
                .done(function (response) {
                    if (response.success) {
                        alert(response.message);
                        window.location.reload();
                        return;
                    }

                    alert(response.message || '移除排隊失敗');
                })
                .fail(function () {
                    alert('移除排隊失敗，請稍後再試');
                });
        }

        function openRescheduleModal(reservationId, reservationDate, reservationTime) {
            document.getElementById('rescheduleReservationId').value = reservationId;
            document.getElementById('rescheduleReservationDate').value = reservationDate;
            document.getElementById('rescheduleReservationTime').value = reservationTime;
            resetReschedulePreview();
            rescheduleModal.show();
        }

        function resetReschedulePreview() {
            const box = document.getElementById('reschedulePreviewBox');
            box.className = 'alert alert-secondary small mb-3';
            box.innerHTML = '請先選擇新的日期與時段，再按「預覽影響」查看這次調整的結果。';
        }

        function previewRescheduleImpact() {
            const reservationId = document.getElementById('rescheduleReservationId').value;
            const reservationDate = document.getElementById('rescheduleReservationDate').value;
            const selectedSlotStartTime = document.getElementById('rescheduleReservationTime').value;
            const box = document.getElementById('reschedulePreviewBox');

            if (!reservationDate || !selectedSlotStartTime) {
                box.className = 'alert alert-warning small mb-3';
                box.innerHTML = '請先選擇新的日期與時段。';
                return;
            }

            box.className = 'alert alert-secondary small mb-3';
            box.innerHTML = '系統推算中...';

            $.get('/Equipment/PreviewRescheduleScheduledReservation', {
                reservationId: reservationId,
                reservationDate: reservationDate,
                selectedSlotStartTime: selectedSlotStartTime
            })
                .done(function (response) {
                    if (!response.success || !response.data) {
                        box.className = 'alert alert-danger small mb-3';
                        box.innerHTML = response.message || '無法預覽這次調整的影響。';
                        return;
                    }

                    const preview = response.data;
                    if (!preview.canReschedule) {
                        box.className = 'alert alert-danger small mb-3';
                        box.innerHTML = preview.message || '這個時段目前無法調整。';
                        return;
                    }

                    const details = [
                        `預計狀態：${preview.targetStatusText}`,
                        `保留名額：${preview.reservedCapacityCount}`,
                        `推算前方等待：${preview.forecastWaitingCount}`,
                        `新時段：${preview.scheduledStartTimeText} - ${preview.scheduledEndTimeText}`
                    ];

                    box.className = preview.queueExpected
                        ? 'alert alert-warning small mb-3'
                        : 'alert alert-success small mb-3';
                    box.innerHTML = `
                        <div class="fw-semibold mb-1">${preview.message}</div>
                        <div>${details.join('｜')}</div>
                    `;
                })
                .fail(function () {
                    box.className = 'alert alert-danger small mb-3';
                    box.innerHTML = '無法預覽這次調整的影響，請稍後再試。';
                });
        }

        function submitRescheduleReservation(confirmQueueExpected) {
            const reservationId = document.getElementById('rescheduleReservationId').value;
            const reservationDate = document.getElementById('rescheduleReservationDate').value;
            const selectedSlotStartTime = document.getElementById('rescheduleReservationTime').value;

            if (!reservationDate || !selectedSlotStartTime) {
                alert('請先選擇新的日期與時段');
                return;
            }

            $.post('/Equipment/ForceRescheduleScheduledReservation', {
                reservationId: reservationId,
                reservationDate: reservationDate,
                selectedSlotStartTime: selectedSlotStartTime,
                confirmQueueExpected: confirmQueueExpected
            })
                .done(function (response) {
                    if (response.success) {
                        rescheduleModal.hide();
                        alert(response.message);
                        window.location.reload();
                        return;
                    }

                    if (response.requiresConfirmation && response.queueExpected) {
                        const message = response.message || '系統推算到時仍可能需要排隊，確定仍要調整到這個時段嗎？';
                        if (confirm(message)) {
                            submitRescheduleReservation(true);
                        }
                        return;
                    }

                    alert(response.message || '調整時段失敗');
                })
                .fail(function () {
                    alert('調整時段失敗，請稍後再試');
                });
        }

        function loadEquipmentChain(equipmentId) {
            $.get('/Equipment/GetEquipmentReservationChain', { equipmentId: equipmentId })
                .done(function (response) {
                    if (!response.success || !response.data) {
                        alert(response.message || '無法取得設備預約鏈資訊');
                        return;
                    }

                    renderEquipmentChain(response.data);
                    const modal = new bootstrap.Modal(document.getElementById('equipmentChainModal'));
                    modal.show();
                })
                .fail(function () {
                    alert('無法取得設備預約鏈資訊');
                });
        }

        function renderEquipmentChain(chain) {
            $('#equipmentChainTitle').text(`${chain.equipmentName} 的預約／排隊鏈`);

            const scheduledRows = (chain.scheduledReservations || []).map(item => `
                <tr>
                    <td>${item.userId}</td>
                    <td>${formatDateTime(item.reservedStartTime)}</td>
                    <td>${formatDateTime(item.reservedEndTime)}</td>
                    <td>${item.statusText}</td>
                </tr>
            `).join('');

            const activeRows = (chain.activeReservations || []).map(item => `
                <tr>
                    <td>${item.userId}</td>
                    <td>${formatDateTime(item.startTime)}</td>
                    <td>${item.remainingTime} 分鐘</td>
                    <td>${item.statusText}</td>
                </tr>
            `).join('');

            const waitingRows = (chain.waitingReservations || []).map(item => `
                <tr>
                    <td>${item.userId}</td>
                    <td>第 ${item.position} 位</td>
                    <td>${item.queueTypeText}</td>
                    <td>${formatDateTime(item.queueTime)}</td>
                </tr>
            `).join('');

            $('#equipmentChainBody').html(`
                <div class="mb-4">
                    <h6>未來預約</h6>
                    ${scheduledRows
                        ? `<table class="table table-sm table-striped"><thead><tr><th>會員</th><th>開始時間</th><th>結束時間</th><th>狀態</th></tr></thead><tbody>${scheduledRows}</tbody></table>`
                        : '<div class="text-muted">目前沒有未來預約。</div>'}
                </div>
                <div class="mb-4">
                    <h6>使用中</h6>
                    ${activeRows
                        ? `<table class="table table-sm table-striped"><thead><tr><th>會員</th><th>開始時間</th><th>剩餘時間</th><th>狀態</th></tr></thead><tbody>${activeRows}</tbody></table>`
                        : '<div class="text-muted">目前沒有使用中資料。</div>'}
                </div>
                <div>
                    <h6>排隊中</h6>
                    ${waitingRows
                        ? `<table class="table table-sm table-striped"><thead><tr><th>會員</th><th>順位</th><th>類型</th><th>排隊時間</th></tr></thead><tbody>${waitingRows}</tbody></table>`
                        : '<div class="text-muted">目前沒有排隊資料。</div>'}
                </div>
            `);
        }

        function formatDateTime(value) {
            const date = new Date(value);
            if (isNaN(date.getTime())) {
                return value || '';
            }

            return date.toLocaleString('zh-TW', {
                year: 'numeric',
                month: '2-digit',
                day: '2-digit',
                hour: '2-digit',
                minute: '2-digit',
                hour12: false
            }).replace(/\//g, '-');
        }
    </script>
</body>
</html>

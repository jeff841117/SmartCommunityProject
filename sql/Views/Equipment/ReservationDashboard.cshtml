@model sql.Models.ReservationManagementPageViewModel
@{
    ViewData["Title"] = "預約與排隊總覽";
    Layout = "";
}

<!DOCTYPE html>
<html lang="zh-TW">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewData["Title"]</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0-alpha1/dist/css/bootstrap.min.css" rel="stylesheet">
</head>
<body class="bg-light">
    <div class="container py-4">
        <div class="d-flex justify-content-between align-items-center mb-4">
            <div>
                <h1 class="fw-bold mb-1">預約與排隊總覽</h1>
                <p class="text-muted mb-0">後台查看目前所有未來預約、使用中與排隊中的狀態</p>
            </div>
            <div class="text-end">
                <a href="/Equipment/Index" class="btn btn-outline-secondary">返回設備管理</a>
                <div class="small text-muted mt-2">更新時間：@Model.Dashboard.ServerTaiwanTime</div>
            </div>
        </div>

        <div class="card mb-4">
            <div class="card-header bg-info text-white">
                <h5 class="mb-0">未來預約</h5>
            </div>
            <div class="card-body">
                @if (Model.Dashboard.ScheduledReservations.Any())
                {
                    <div class="table-responsive">
                        <table class="table table-striped align-middle">
                            <thead>
                                <tr>
                                    <th>設備</th>
                                    <th>會員</th>
                                    <th>預約時段</th>
                                    <th>狀態</th>
                                    <th>建立時間</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var reservation in Model.Dashboard.ScheduledReservations)
                                {
                                    <tr>
                                        <td>@reservation.EquipmentName</td>
                                        <td>@reservation.UserId</td>
                                        <td>@reservation.ReservedStartTime.ToString("yyyy-MM-dd HH:mm") - @reservation.ReservedEndTime.ToString("HH:mm")</td>
                                        <td>
                                            <span class="badge @(reservation.Status == 5 ? "bg-warning text-dark" : "bg-info text-dark")">
                                                @reservation.StatusText
                                            </span>
                                        </td>
                                        <td>@reservation.ReservationTime.ToString("yyyy-MM-dd HH:mm")</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
                else
                {
                    <div class="text-muted">目前沒有未來預約。</div>
                }
            </div>
        </div>

        <div class="card mb-4">
            <div class="card-header bg-primary text-white">
                <h5 class="mb-0">使用中</h5>
            </div>
            <div class="card-body">
                @if (Model.Dashboard.ActiveReservations.Any())
                {
                    <div class="table-responsive">
                        <table class="table table-striped align-middle">
                            <thead>
                                <tr>
                                    <th>設備</th>
                                    <th>會員</th>
                                    <th>開始時間</th>
                                    <th>剩餘時間</th>
                                    <th>狀態</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var reservation in Model.Dashboard.ActiveReservations)
                                {
                                    <tr>
                                        <td>@reservation.EquipmentName</td>
                                        <td>@reservation.UserId</td>
                                        <td>@reservation.StartTime.ToString("yyyy-MM-dd HH:mm")</td>
                                        <td>@reservation.RemainingTime 分鐘</td>
                                        <td><span class="badge bg-primary">@reservation.StatusText</span></td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
                else
                {
                    <div class="text-muted">目前沒有使用中的設備。</div>
                }
            </div>
        </div>

        <div class="card">
            <div class="card-header bg-warning text-dark">
                <h5 class="mb-0">排隊中</h5>
            </div>
            <div class="card-body">
                @if (Model.Dashboard.WaitingReservations.Any())
                {
                    <div class="table-responsive">
                        <table class="table table-striped align-middle">
                            <thead>
                                <tr>
                                    <th>設備</th>
                                    <th>會員</th>
                                    <th>順位</th>
                                    <th>加入時間</th>
                                    <th>排隊來源</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var queue in Model.Dashboard.WaitingReservations)
                                {
                                    <tr>
                                        <td>@queue.EquipmentName</td>
                                        <td>@queue.UserId</td>
                                        <td>第 @queue.Position 位</td>
                                        <td>@queue.QueueTime.ToString("yyyy-MM-dd HH:mm")</td>
                                        <td>@queue.QueueTypeText</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
                else
                {
                    <div class="text-muted">目前沒有排隊中的設備。</div>
                }
            </div>
        </div>
    </div>
</body>
</html>

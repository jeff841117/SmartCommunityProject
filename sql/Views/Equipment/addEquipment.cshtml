@{
    Layout = "";
}
<!DOCTYPE html>
<html lang="zh-TW">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>新增設備</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0-alpha1/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="~/css/addEquipment.css" rel="stylesheet" asp-append-version="true">
</head>
<body>
    <div class="form-container">
        <h2>新增設備</h2>
        <form method="post" action="/Equipment/addEquipment">
            <div class="form-group row">
                <label for="inputEquipmentName" class="col-sm-2 col-form-label">設備名稱</label>
                <div class="col-sm-10">
                    <input type="text" id="inputName" name="equipmentName" class="form-control" />
                </div>
            </div>
            <div class="form-group row">
                <label for="inputUsageLimit" class="col-sm-2 col-form-label">同時間設備使用上限</label>
                <div class="col-sm-10">
                    <input type="text" id="inputMaxUsers" name="MaxUsers" class="form-control" />
                </div>
            </div>
            <div class="form-group row">
                <label for="inputUsageTime" class="col-sm-2 col-form-label">可使用時間</label>
                <div class="col-sm-10">
                    <input type="text" id="inputAvailableTime" name="AvailableTime" class="form-control" />
                </div>
            </div>
            <div class="form-group row">
                <label for="inputOpenTime" class="col-sm-2 col-form-label">開放時間</label>
                <div class="col-sm-10">
                    <input type="time" id="inputOpenTime" name="OpenTime" class="form-control" />
                    <div class="time-note">請選擇每日開放使用的開始時間</div>
                </div>
            </div>
            <div class="form-group row">
                <label for="inputCloseTime" class="col-sm-2 col-form-label">關閉時間</label>
                <div class="col-sm-10">
                    <input type="time" id="inputCloseTime" name="CloseTime" class="form-control" />
                    <div class="time-note">請選擇每日開放使用的結束時間</div>
                </div>
            </div>
            <div class="form-group row">
                <div class="col-sm-12">
                    <input class="btn btn-primary btn-submit" type="submit" value="新增" />
                </div>
            </div>
        </form>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0-alpha1/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
@model sql.Models.AddAccountFormViewModel
@{
    Layout = "";
}

<link href="~/css/addAccount.css" rel="stylesheet" asp-append-version="true">
<div class="header-section">
    <div class="container">
        <h1 class="display-4 fw-bold">新增帳號</h1>
        <p class="lead">創建新的用戶帳戶</p>
    </div>
</div>

<div class="container">
    <div class="form-container">
        <form method="post" action="/Home/addAccount">
            @if (!string.IsNullOrWhiteSpace(Model.ErrorMessage))
            {
                <div class="alert alert-danger" role="alert">
                    @Model.ErrorMessage
                </div>
            }

            <div class="form-group row">
                <label asp-for="UserName" class="col-sm-2 col-form-label form-label">帳號名稱</label>
                <div class="col-sm-10">
                    <input asp-for="UserName" class="form-control" placeholder="請輸入帳號名稱" />
                    <span asp-validation-for="UserName" class="text-danger"></span>
                </div>
            </div>
            <div class="form-group row">
                <label asp-for="Password" class="col-sm-2 col-form-label form-label">帳號密碼</label>
                <div class="col-sm-10">
                    <input asp-for="Password" type="password" class="form-control" placeholder="請輸入密碼" />
                    <span asp-validation-for="Password" class="text-danger"></span>
                </div>
            </div>
            <div class="form-group row">
                <label asp-for="Age" class="col-sm-2 col-form-label form-label">帳號年齡</label>
                <div class="col-sm-10">
                    <input asp-for="Age" type="number" class="form-control" placeholder="請輸入年齡" min="1" />
                    <span asp-validation-for="Age" class="text-danger"></span>
                </div>
            </div>
            <div class="form-group row">
                <label asp-for="Email" class="col-sm-2 col-form-label form-label">電子郵件</label>
                <div class="col-sm-10">
                    <input asp-for="Email" type="email" class="form-control" placeholder="請輸入電子郵件" />
                    <span asp-validation-for="Email" class="text-danger"></span>
                </div>
            </div>
            <div class="form-group row">
                <label asp-for="Phone" class="col-sm-2 col-form-label form-label">手機號碼</label>
                <div class="col-sm-10">
                    <input asp-for="Phone" type="tel" class="form-control" placeholder="請輸入手機號碼" />
                    <span asp-validation-for="Phone" class="text-danger"></span>
                </div>
            </div>
            <div class="form-group row">
                <div class="col-sm-12">
                    <button class="btn btn-primary btn-submit" type="submit">新增帳號</button>
                </div>
            </div>
        </form>
    </div>
</div>

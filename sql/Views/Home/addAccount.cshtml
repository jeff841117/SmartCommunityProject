@{
    Layout = "";
}

<link href="~/css/addAccount.css" rel="stylesheet" asp-append-version="true">
<div class="header-section">
    <div class="container">
        <h1 class="display-4 fw-bold">新增帳號</h1>
        <p class="lead">創建新的用戶帳戶</p>
    </div>
</div>

<div class="container">
    <div class="form-container">
        <form method="post" action="/Home/addAccount">
            <div class="form-group row">
                <label for="inputUserName" class="col-sm-2 col-form-label form-label">帳號名稱</label>
                <div class="col-sm-10">
                    <input type="text" id="inputUserName" name="userName" class="form-control" placeholder="請輸入帳號名稱" />
                </div>
            </div>
            <div class="form-group row">
                <label for="inputPasswd" class="col-sm-2 col-form-label form-label">帳號密碼</label>
                <div class="col-sm-10">
                    <input type="password" id="inputPasswd" name="password" class="form-control" placeholder="請輸入密碼" />
                </div>
            </div>
            <div class="form-group row">
                <label for="inputName" class="col-sm-2 col-form-label form-label">帳號年齡</label>
                <div class="col-sm-10">
                    <input type="number" id="inputName" name="age" class="form-control" placeholder="請輸入年齡" min="1" />
                </div>
            </div>
            <div class="form-group row">
                <label for="inputEmail" class="col-sm-2 col-form-label form-label">電子郵件</label>
                <div class="col-sm-10">
                    <input type="email" id="inputEmail" name="email" class="form-control" placeholder="請輸入電子郵件" />
                </div>
            </div>
            <div class="form-group row">
                <label for="inputPhone" class="col-sm-2 col-form-label form-label">手機號碼</label>
                <div class="col-sm-10">
                    <input type="tel" id="inputPhone" name="phone" class="form-control" placeholder="請輸入手機號碼" />
                </div>
            </div>
            <div class="form-group row">
                <div class="col-sm-12">
                    <button class="btn btn-primary btn-submit" type="submit">新增帳號</button>
                </div>
            </div>
        </form>
    </div>
</div>
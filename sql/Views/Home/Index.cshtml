@model sql.Models.AccountManagementPageViewModel
@{
    ViewData["Title"] = "註冊帳號";
}
<link href="~/css/indexHome.css" rel="stylesheet" asp-append-version="true">
<div class="header-section">
    <div class="container">
        <h1 class="display-4 fw-bold">帳戶管理系統</h1>
        <p class="lead">管理所有用戶帳戶信息</p>
    </div>
</div>

<div class="container">
    <div class="button-container">
        <a href="/Home/addAccount" class="add-equipment-btn">新增帳號</a>
    </div>
    <div class="button-container">
        <a href="/Equipment/addEquipment" class="add-equipment-btn">新增設備</a>
    </div>
    <div class="button-container">
        <a href="/Equipment/ReservationDashboard" class="add-equipment-btn">預約與排隊總覽</a>
    </div>
    <div class="button-container">
        <a href="/Home/AdminActionLogs" class="add-equipment-btn">管理者操作紀錄</a>
    </div>

    <div class="table-container">
        <table class="table table-hover">
            <thead>
                <tr>
                    <th>編號</th>
                    <th>帳號</th>
                    <th>密碼</th>
                    <th>年齡</th>
                    <th>電子郵件</th>
                    <th>手機號碼</th>
                    <th>權限</th>
                    <th>操作</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var user in Model.Accounts)
                {
                    <tr id="row-@user.id">
                        <td>@user.id</td>
                        <td>@user.userName</td>
                        <td class="password-cell">
                            <span class="password-text">@user.password</span>
                            <input type="password" class="form-control form-control-sm password-input" value="@user.password" placeholder="新密碼" style="display:none;">
                        </td>
                        <td>@user.age</td>
                        <td class="email-cell">
                            <span class="email-text">@user.email</span>
                            <input type="email" class="form-control form-control-sm email-input" value="@user.email" placeholder="電子郵件" style="display:none;">
                        </td>
                        <td class="phone-cell">
                            <span class="phone-text">@user.phone</span>
                            <input type="tel" class="form-control form-control-sm phone-input" value="@user.phone" placeholder="手機號碼" style="display:none;">
                        </td>
                        <td>@user.role</td>
                        <td>
                            @if (user.role == "user")
                            {
                                <button class="btn btn-primary btn-sm edit-btn" data-id="@user.id">編輯</button>
                                <button class="btn btn-success btn-sm save-btn" data-id="@user.id" style="display:none;">儲存</button>
                                <button class="btn btn-secondary btn-sm cancel-btn" data-id="@user.id" style="display:none;">取消</button>
                            }
                            else
                            {
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
<script id="edit-template" type="text/template">
    <input type="password" class="form-control form-control-sm password-input" value="{password}" placeholder="新密碼">
    <input type="email" class="form-control form-control-sm email-input" value="{email}" placeholder="電子郵件">
    <input type="tel" class="form-control form-control-sm phone-input" value="{phone}" placeholder="手機號碼">
</script>
<script src="~/lib/jquery/dist/jquery.min.js"></script>
<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0-alpha1/dist/js/bootstrap.bundle.min.js"></script>
<script src="~/js/indexHome.js" asp-append-version="true"></script>
